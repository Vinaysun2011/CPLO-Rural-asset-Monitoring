# Copy this file to ".env" and fill in your values. Never share the .env file.

# Database (use the READ-ONLY user)
DB_HOST=your-db-host-or-ip
DB_PORT=3306
DB_USER=readonly_user
DB_PASSWORD=your_password
# Leave empty if the SQL already uses full table names; otherwise put the schema name
DB_NAME=

# Random long text, used to sign login sessions
SECRET_KEY=change-this-to-a-long-random-string

# Client logins: username:password, separated by commas
APP_USERS=client1:StrongPass1,client2:StrongPass2

# Optional
PORT=5000
# Seconds to reuse a result so many users don't hit the database repeatedly
CACHE_SECONDS=60
# Max seconds the query may run
QUERY_TIMEOUT=120
